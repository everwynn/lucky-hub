---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '双色球开奖数据统计与号码生成，仅供个人娱乐参考' } = Astro.props;
const nav = [
  { href: '/', label: '首页' },
  { href: '/generate', label: '生成号码' },
  { href: '/about', label: '关于' },
];
const withBase = (p: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${p}`;
// 去掉 base 前缀后与 nav 的 href 比较，判断当前页
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f7f9" />
    <title>{title} · lucky-hub</title>

    <!-- 主题初始化：必须放在 body 之前、首帧之前执行，否则会先渲染一帧亮色再变暗（闪白）。
         三态 light | dark | system（默认 system）；只切 class / color-scheme，不做渐变。 -->
    <script is:inline>
      (function () {
        var KEY = 'lucky-theme';
        var MODES = ['light', 'dark', 'system'];
        var root = document.documentElement;
        var media = window.matchMedia('(prefers-color-scheme: dark)');

        function readMode() {
          try {
            var saved = localStorage.getItem(KEY);
            if (MODES.indexOf(saved) !== -1) return saved;
          } catch (err) {
            /* 隐私模式下 localStorage 不可读，按跟随系统处理 */
          }
          return 'system';
        }

        function apply(mode, persist) {
          var resolved = mode === 'system' ? (media.matches ? 'dark' : 'light') : mode;
          root.classList.toggle('dark', resolved === 'dark');
          root.setAttribute('data-theme-mode', mode);
          root.style.colorScheme = resolved;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', resolved === 'dark' ? '#0f1115' : '#f6f7f9');
          if (persist) {
            try {
              localStorage.setItem(KEY, mode);
            } catch (err) {
              /* 写不进去就只影响本次会话 */
            }
          }
        }

        apply(readMode(), false);

        // 用户选了「跟随系统」时，系统切换深浅色要同步跟上
        var onSystemChange = function () {
          var mode = root.getAttribute('data-theme-mode') || 'system';
          if (mode === 'system') apply('system', false);
        };
        if (media.addEventListener) media.addEventListener('change', onSystemChange);
        else if (media.addListener) media.addListener(onSystemChange);

        // 暴露给 ThemeToggle.astro 使用，避免两处各写一套 apply 逻辑
        window.__luckyTheme = { apply: apply, read: readMode };
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-20 border-b border-line bg-surface/85 backdrop-blur">
      <nav class="mx-auto flex min-h-12 max-w-3xl items-center gap-x-5 px-4 text-sm">
        {nav.map((item) => (
          <a
            class={`flex min-h-12 items-center border-b-2 transition ${
              item.href === path
                ? 'border-lucky-red font-medium text-body'
                : 'border-transparent text-muted hover:text-body'
            }`}
            href={withBase(item.href)}
          >{item.label}</a>
        ))}
        <div class="ml-auto">
          <ThemeToggle />
        </div>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 pb-8 pt-5">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-3xl px-4 pb-10 text-xs leading-6 text-muted">
      <p>数据来源：中国福利彩票官网公开开奖数据。仅供娱乐参考，不构成投注建议，请理性购彩（18+）。</p>
      <p>最后构建：{new Date().toISOString().slice(0, 10)}</p>
    </footer>
  </body>
</html>
