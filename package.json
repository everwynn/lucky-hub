{
  "name": "lucky-hub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node scripts/sync-data.mjs && astro dev",
    "build": "node scripts/sync-data.mjs && astro build",
    "preview": "astro preview",
    "fetch": "node scripts/fetch.mjs",
    "backfill": "node scripts/backfill.mjs",
    "test": "node --test tests/scripts/",
    "test:lib": "node --import tsx --test tests/lib/data.test.ts tests/lib/generate.test.ts"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.5",
    "@astrojs/vue": "^4.5.3",
    "astro": "^4.16.19",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
